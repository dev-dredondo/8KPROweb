    <string name="sync_status_trending_detail_completed">Matched · Movies: <xliff:g id="movie_matches">%1$d</xliff:g>/<xliff:g id="movie_candidates">%2$d</xliff:g> · Series: <xliff:g id="series_matches">%3$d</xliff:g>/<xliff:g id="series_candidates">%4$d</xliff:g></string>
    <string name="sync_status_trending_preparing">Preparing provider titles for fast matching</string>
