case "$(uname -s)" in
  Darwin)
    export JAVA_HOME="${JAVA_HOME:-$(/usr/libexec/java_home)}"
    ;;
  Linux)
    if [ -z "${JAVA_HOME:-}" ]; then
      java_bin="$(command -v java)"
      export JAVA_HOME="$(dirname "$(dirname "$(readlink -f "$java_bin")")")"
      unset java_bin
    fi
    ;;
esac
export GRADLE_USER_HOME="$PWD/.gradle-cache"
