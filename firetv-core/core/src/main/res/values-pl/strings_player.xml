    <string name="player_error_exo_decode">ExoPlayer nie może zdekodować formatu tego materiału wideo na tym urządzeniu (<xliff:g id="error">%1$s</xliff:g>).</string>
    <string name="player_error_exo_play">ExoPlayer nie mógł odtworzyć tego strumienia (<xliff:g id="error">%1$s</xliff:g>).</string>
    <string name="player_error_image_format">Napisy graficzne nie są dostępne dla formatu tego pliku.</string>
