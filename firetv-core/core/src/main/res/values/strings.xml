    <string name="sync_progress_preparing">Preparing catalog</string>
    <!-- Translators: Status text during sync when connecting to the source. -->
    <string name="sync_progress_connecting">Connecting to source\u2026</string>
    <!-- Translators: Status text during sync when syncing the catalog. -->
    <string name="sync_progress_syncing">Syncing catalog</string>
