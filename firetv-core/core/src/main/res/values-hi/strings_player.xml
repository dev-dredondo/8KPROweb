    <string name="player_error_audio_no_video">ऑडियो चल रहा है, लेकिन इस डिवाइस पर वीडियो रेंडर नहीं किया जा सका।</string>
    <string name="player_error_file_corrupt">इस वीडियो की फ़ाइल विकृत या खराब है और इसे चलाया नहीं जा सकता।</string>
    <string name="player_error_multiple_videos">एक से अधिक वीडियो नहीं चल सके। स्रोत अनुपलब्ध हो सकता है या फ़ाइलें खराब हो सकती हैं।</string>
    <string name="player_error_decoder_busy">इस टीवी का वीडियो डिकोडर व्यस्त है। कुछ देर बाद फिर से कोशिश करें।</string>
    <string name="player_error_no_internet">इंटरनेट कनेक्शन नहीं है। अपना नेटवर्क जाँचें और फिर से कोशिश करें।</string>
    <string name="player_error_stream_unavailable">यह स्ट्रीम नहीं चलाई जा सकी। स्रोत ऑफ़लाइन हो सकता है या असमर्थित फ़ॉर्मैट का उपयोग कर सकता है। <xliff:g id="hint">%1$s</xliff:g></string>
    <string name="player_error_account_in_use">यह खाता पहले से किसी दूसरे डिवाइस या ऐप पर चल रहा है। वहाँ इसे रोकें, फिर दोबारा कोशिश करें दबाएँ।</string>
    <string name="player_error_mpv_open_decode">mpv इस फ़ाइल को खोल या डिकोड नहीं सका।</string>
