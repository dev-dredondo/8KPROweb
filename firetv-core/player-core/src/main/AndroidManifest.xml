<?xml version="1.0" encoding="utf-8"?>
<!-- Merged into every consuming app, so the test for each entry is: would the phone app want this?
     Audio-effect access is the engine's own requirement, not a shell's. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- VolumeBoost attaches a LoudnessEnhancer to the audio session. -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <application>
        <!-- ScreenOff: lets the sleep timer turn the screen off, once the user has granted it. -->
        <receiver
            android:name="tv.own.owntv.player.ScreenOff$Admin"
            android:description="@string/player_sleep_timer_screen_off_explanation"
            android:exported="true"
            android:label="@string/player_sleep_timer"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/screen_off_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
