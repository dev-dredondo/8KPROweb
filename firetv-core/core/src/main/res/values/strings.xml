    <!-- Translators: Sync status with counts. "source" is the source name, "counts" is a formatted count string. -->
    <string name="sync_status_catalog_with_counts">Syncing <xliff:g id="source">%1$s</xliff:g> \u00b7 <xliff:g id="counts">%2$s</xliff:g></string>
