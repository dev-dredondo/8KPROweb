    <!-- Translators: Error message when the device appears to be offline during a sync operation. -->
    <string name="sync_error_offline">You appear to be offline. Check your connection and try again.</string>
    <!-- Translators: Generic sync error message. -->
    <string name="sync_error_generic">Something went wrong. Please try again.</string>
    <!-- Translators: Error message when the server responds too slowly during sync. -->
    <string name="sync_error_timeout">The server took too long to respond. Please try again.</string>
    <!-- Translators: Error message when the server is unreachable during sync. -->
    <string name="sync_error_unreachable">Couldn\'t reach the server. Check the address and your connection.</string>
    <!-- Translators: Error message when the server connection fails during sync. -->
    <string name="sync_error_connection">Couldn\'t connect to the server. It may be down, or the address may be wrong.</string>
    <!-- Translators: Error message when the server interrupts the download during sync. -->
    <string name="sync_error_interrupted">The server interrupted the download. Please try again.</string>
    <!-- Translators: Error message when the Stalker portal rejects the MAC address. Suggests checking MAC and date/time. -->
    <string name="sync_error_mac">The portal refused this MAC address. Check the MAC (and the TV\'s date &amp; time) \u2014 or the subscription may have expired.</string>
    <!-- Translators: Error message when the MAC address format is invalid. "AA:BB:CC:DD:EE:FF" is an example format. -->
    <string name="sync_error_invalid_mac">Invalid MAC address \u2014 use AA:BB:CC:DD:EE:FF</string>
    <!-- Translators: Separator between sync count segments. The middle dot (·) is surrounded by spaces. -->
    <string name="sync_counts_separator">"  ·  "</string>
    <!-- Translators: Status text when sync completes successfully. -->
    <string name="sync_counts_success">Synced successfully</string>
    <!-- Translators: Sync count summary. "counts" is a formatted count string. -->
    <string name="sync_counts_synced"><xliff:g id="counts">%1$s</xliff:g> synced</string>
    <!-- Translators: Import warning summary. "phases" is a list of warning messages. -->
    <string name="sync_import_warnings">Imported with warnings: <xliff:g id="phases">%1$s</xliff:g></string>
    <!-- Translators: Individual sync warning. "phase" is the phase name, "message" is the warning text. -->
    <string name="sync_warning_phase_error"><xliff:g id="phase">%1$s</xliff:g>: <xliff:g id="message">%2$s</xliff:g></string>
    <!-- Translators: Plural warning when the import returned fewer items than stored. "stored" is the existing count, "percent" is the reduction percentage. -->
    <plurals name="sync_warning_catalog_shrink">
        <item quantity="one">Kept <xliff:g id="stored">%1$d</xliff:g> existing item \u2014 this import returned <xliff:g id="percent">%2$d</xliff:g>%% fewer. Sync again, or use Force clean sync if the provider really removed it.</item>
        <item quantity="other">Kept <xliff:g id="stored">%1$d</xliff:g> existing items \u2014 this import returned <xliff:g id="percent">%2$d</xliff:g>%% fewer. Sync again, or use Force clean sync if the provider really removed them.</item>
    </plurals>
    <!-- Translators: Warning when the provider's single big catalog response was cut off mid-transfer and the app recovered the rest by asking for one category at a time. The catalog is complete; it just took longer. -->
    <string name="sync_warning_bulk_truncated">The provider\'s list was cut off part-way, so the rest was fetched category by category. Everything is here, but this sync took longer than usual.</string>
    <!-- Translators: Warning when the provider's catalog response was cut off and the recovery could not retrieve everything. Some titles are missing until the next sync. -->
    <string name="sync_warning_bulk_truncated_partial">The provider\'s list was cut off part-way and not everything could be recovered. Some titles may be missing until the next sync.</string>
    <!-- Translators: Plural warning when source pages fail during sync. "count" is the number of failed pages. -->
    <plurals name="sync_warning_page_failures">
        <item quantity="one"><xliff:g id="count">%1$d</xliff:g> source page failed; some content may be missing until the next sync.</item>
        <item quantity="other"><xliff:g id="count">%1$d</xliff:g> source pages failed; some content may be missing until the next sync.</item>
    </plurals>
    <!-- Translators: Informational text during background sync. Directs the user to the progress pill. -->
    <string name="sync_remainder_note">The rest of the catalog is still syncing in the background \u2014 you can start watching now. Progress shows in the small pill at the bottom of the screen.</string>
